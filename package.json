{
  "name": "auraclip-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:coverage:rust": "rustup run stable cargo llvm-cov --manifest-path src-tauri/Cargo.toml --html",
    "preflight": "node scripts/run-preflight-tests.mjs",
    "lint": "eslint src",
    "lint:styles": "node scripts/lint-styles.mjs",
    "apply-version": "node scripts/apply-app-version.mjs",
    "tauri": "node scripts/run-tauri.mjs",
    "tauri:dev": "node scripts/apply-app-version.mjs && node scripts/run-tauri.mjs dev --features devtools",
    "tauri:build": "node scripts/apply-app-version.mjs && tauri build",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "framer-motion": "^12.25.0",
    "lucide-react": "^0.562.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-virtuoso": "^4.18.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "react-refresh": "^0.19.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.4",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  }
}
