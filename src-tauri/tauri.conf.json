{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuraClip",
  "version": "1.0.0",
  "identifier": "com.auradesk.auraclip",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [
      {
        "title": "AuraClip",
        "label": "main",
        "width": 352,
        "height": 380,
        "minWidth": 250,
        "minHeight": 300,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": false,
        "decorations": false,
        "devtools": false,
        "skipTaskbar": true,
        "visible": false,
        "dragDropEnabled": false,
        "focusable": true
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob: http: https:; media-src 'self' asset: http://asset.localhost https://asset.localhost data: blob: http://127.0.0.1:*; video-src 'self' asset: http://asset.localhost https://asset.localhost data: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ws: http: https:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "$HOME/**",
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$PROFILE/**"
        ]
      },
      "capabilities": [
        {
          "identifier": "main-capability",
          "description": "Main window capabilities",
          "windows": [
            "*"
          ],
          "permissions": [
            "core:window:allow-start-dragging",
            "core:window:allow-hide",
            "core:window:allow-show",
            "core:window:allow-close",
            "core:window:allow-set-focus",
            "core:window:allow-is-visible",
            "core:window:allow-inner-size",
            "core:window:allow-inner-position",
            "core:window:allow-scale-factor",
            "core:window:allow-set-size",
            "core:window:allow-set-position",
            "core:window:allow-set-always-on-top",
            "core:window:allow-set-visible-on-all-workspaces",
            "core:window:allow-current-monitor",
            "core:window:allow-cursor-position",
            "core:window:allow-create",
            "core:window:allow-get-all-windows",
            "core:webview:allow-create-webview-window",
            "core:window:allow-set-ignore-cursor-events",
            "core:window:allow-set-focusable",
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "core:event:allow-emit",
            "core:app:allow-version",
            "core:app:default",
            "dialog:allow-open",
            "dialog:allow-save",
            "dialog:default",
            {
              "identifier": "core:path:default",
              "allow": [
                {
                  "path": "$HOME/**"
                },
                {
                  "path": "$APPDATA/**"
                },
                {
                  "path": "$APPLOCALDATA/**"
                },
                {
                  "path": "$PROFILE/**"
                }
              ]
            },
            "window-state:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "compression": "lzma",
        "installerHooks": "nsis/uninstall.nsh",
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese"
        ],
        "displayLanguageSelector": true,
        "startMenuFolder": "AuraClip"
      }
    }
  }
}
